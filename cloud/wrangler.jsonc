{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quickbox-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // Used until users can set their own time zone.
    "DEFAULT_TIMEZONE": "UTC"
  },
  "durable_objects": {
    "bindings": [{ "name": "INBOX", "class_name": "InboxStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["InboxStore"] }]
}
